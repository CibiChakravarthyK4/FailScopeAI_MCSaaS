# development | staging | production | demo
APP_ENV=development

DATABASE_URL=postgresql+psycopg2://failscope:failscope@127.0.0.1:5433/failscope
REDIS_URL=redis://127.0.0.1:6380/0

SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8010/auth/google/callback

FRONTEND_URL=http://localhost:5180
ALLOWED_ORIGINS=["http://localhost:5180"]

OPENAI_API_KEY=
# Point at an OpenAI-compatible endpoint instead of the real API (used by the
# E2E suite's stub provider). Leave blank to use the real OpenAI API.
OPENAI_BASE_URL=
MODEL_COST_CEILING_USD=5.0

STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=25
MAX_STORAGE_MB_PER_TENANT=500

STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO=
STRIPE_WEBHOOK_SECRET=

# Platform Owner accounts are created via scripts/seed_platform_owner.py, not
# an env var - see CLAUDE.md Section 15.
